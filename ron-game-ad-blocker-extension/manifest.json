{
  "manifest_version": 3,
  "name": "Ron | Game Ad Blocker",
  "version": "1.0.1",
  "description": "Network-level ad blocking for browser games, paired with Ron | Game Ad Cleaner.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Ron | Game Ad Blocker"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "game_ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}